# Google Gemini API Configuration
# 발급받으신 Gemini API 키를 입력해 주세요.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명 (기본값: gemini-3.7-flash, gemini-1.5-flash, gemini-1.5-pro 등)
VITE_GEMINI_MODEL=gemini-3.7-flash

# Kakao Maps API Configuration (JavaScript 키)
# Kakao Developers (https://developers.kakao.com)에서 발급받은 JavaScript 키를 입력하세요.
# (앱 내 설정 버튼에서도 직접 입력 가능합니다)
VITE_KAKAO_MAP_API_KEY=your_kakao_javascript_key_here


# 카카오 REST API 키 (지오코딩 스크립트 전용, 선택)
# 지도 JS 키와 달리 서버용이라 허용 도메인 제한이 걸리지 않으므로
# 절대 코드에 하드코딩하지 말 것. 미설정 시 Secret Manager(kakao-rest-key)에서 읽는다.
KAKAO_REST_KEY=
