# Cloud Build 로 올릴 소스 범위.
# 이 파일이 없으면 gcloud 는 .gitignore 를 대신 읽는다 — 그러면 의도와 다른 것이
# 빠지거나 포함되므로 반드시 명시한다.

.git
.gitignore
.gcloudignore

node_modules
server/node_modules

# 빌드 산출물은 컨테이너 안에서 다시 만든다
/dist/
/server/dist/
/build/

# 원본·생성 데이터는 이미지에 넣지 않는다 (런타임에 GCS 에서 읽음)
# 앞에 / 를 붙여 루트로 앵커링한다 — 그냥 data 라고 쓰면 src/data 까지 제외돼
# characters.ts, jejuDialectData.ts 가 사라진다.
/data/
src/data/poiData.ts
src/data/ragKnowledgeBase.ts
src/data/ragFullCorpus.json
server/src/data/ragFullCorpus.json

# 시크릿
.env
.env.*

# 문서·목업 (런타임과 무관)
*.md
docent_concept_mockup.html
docent_presentation.html
docent_ui_concept_recommendation.html

.DS_Store
.claude
nginx.conf
